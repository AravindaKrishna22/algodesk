# Copy this file to .env and fill in real values. NEVER commit .env.
BROKER_NAME=paper

# Paper mode requires no credentials.
# To use live trading, set BROKER_NAME=zerodha and fill in the ZERODHA keys below.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# Zerodha Kite Connect (Live API)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Paths
ALGODESK_CONFIG=config/settings.yaml
STATE_DIR=state
LOG_DIR=logs

# Creating a file with this name stops trading and squares off everything
KILL_SWITCH_FILE=KILL